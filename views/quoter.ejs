<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="./css/style.css">
    <link rel="stylesheet" href="./css/output.css">
    <title>Quoter</title>
</head>
<body>

    <div class="flex flex-col p-[2%]">
        <form action="/conversion" method="post" id="formParametros">
            <div class="flex flex-row justify-evenly items-center min-w-[80%] w-full my-[2%] px-[1%]">   
                <div class="flex flex-row justify-center items-center w-full min-w-max" id="divButtonParams">
                    <div >
                        <button class="button" id="viewParams" type="button">Mostrar Parametros</button>
                    </div>                
                    
                </div>
                <div class="flex flex-row justify-center not-visible items-center w-full min-w-max" id="divParams">
                    <%- include("inputsParameters/tablaParametros") %>
                </div>
                <div class="flex  justify-center items-center w-full min-w-max">
                    <div class="flex flex-row justify-center items-center w-full max-w-[90%]">
                        <div class="flex">
                            <button type="button" class="buttonResult" id="preView">Pre - Visualización</button>
                        </div>                    

                        <%- include("inputsParameters/result") %>
                    </div>                 
                </div>
            </div>
            <div class="flex flex-col justify-center items-center w-full min-w-max p-[1%]">
                <%- include("inputsParameters/filaParametros") %>
                <div class="flex flex-row justify-center-safe w-full min-w-max my-[2%]">
                    <div  class="buttonEnviar mr-3">
                        <button type="submit" form="formParametros">Enviar</button>
                    </div>
                    <div  class="buttonEnviar ml-3">
                        <button type="button" id="calcular">Calcular</button>
                    </div>
                </div>
            </div>            
        </form>
    </div>
    <script type="module" src="./js/main.js"></script>
    <script type="module" src="./js/solicitudes.js"></script>
</body>
</html>