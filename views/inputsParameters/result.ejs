<div class="flex w-full min-w-max not-visible px-[3%]" id="divTableResults">
<table class="table-auto  border-collapse w-full min-w-max" id="tableResults">
  <thead>
    <tr>
      <th class="p-2 bg-[#F8CBAD]"><strong>*</strong></th>
      <th class="cardResultHead"><strong>Costo Unit.</strong></th>
      <th class="cardResultHead"><strong>Costo Ext.</strong></th>
      <th class="cardResultHead"><strong>Precio Unit.</strong></th>
      <th class="cardResultHead"><strong>Precio con Desc. Unit.</strong></th>
      <th class="cardResultHead"><strong>Precio con Desc. Ext.</strong></th>
      <th class="cardResultHead"><strong>Costo x Sitio Mens.</strong></th>
      <th class="cardResultHead"><strong>Precio x Sitio Mens.</strong></th>
      <th class="cardResultHead"><strong>Costo x Mbps Mens.</strong></th>
      <th class="cardResultHead"><strong>Precio x Mbps Mens.</strong></th>
      <th class="cardResultHead"><strong>Capex Financiando</strong></th>
      <th class="cardResultHead"><strong>Precio Mens. Fin. x Sitio</strong></th>
    </tr>
  </thead>
  <tbody id="tbodyRowsResults">
    <tr>
      <td>
        <div>
          <strong>1</strong>
        </div>
      </td>

      <td class="cardResultData">
        <strong> 
          <% if (typeof res !== "undefined") { %>
            <%= res.cost %>  
          <% } %>
        </strong>
      </td>
      <td class="cardResultData">
        <strong>
          <% if (typeof res !== "undefined") { %>
            <%= res.extCost %>
          <% } %>
        </strong>
      </td>
      <td class="cardResultData">
        <strong>
          <% if (typeof res !== "undefined") { %>
            <%= res.unitPrice %> 
          <% } %>          
        </strong>
      </td>
      <td class="cardResultData">
        <strong>
          <% if (typeof res !== "undefined") { %>
            <%= res.unitDiscPrice %> 
          <% } %>                    
        </strong>
      </td>
      <td class="cardResultData">
        <strong> 
          <% if (typeof res !== "undefined") { %>            
            <%= res.extDiscPrice %> 
          <% } %>
        </strong>
      </td>
      <td class="cardResultData">
        <strong> 
          <% if (typeof res !== "undefined") { %>
            <%= res.monthlyCostSite %> 
          <% } %>
        </strong>
      </td>
      <td class="cardResultData">
        <strong>
          <% if (typeof res !== "undefined") { %>
            <%= res.monthlyPriceSite %> 
          <% } %>
        </strong>
      </td>
      <td class="cardResultData">
        <strong>
          <% if (typeof res !== "undefined") { %>
            <%= res.monthlyCostMbps %> 
          <% } %>
        </strong>
      </td>
      <td class="cardResultData">
        <strong> 
          <% if (typeof res !== "undefined") { %>
            <%= res.monthlyPriceMbps %> 
          <% } %>
        </strong>
      </td>
      <td class="cardResultData">
        <strong>
          <% if (typeof res !== "undefined") { %>
            <%= res.financedCapex %> 
          <% } %>
        </strong>
      </td>
      <td class="cardResultData">
        <strong>
          <% if (typeof res !== "undefined") { %>
            <%= res.financedMonthlyPriceSite %> 
          <% } %>
        </strong>
      </td>

    </tr>
  </tbody>    
</table>    

</div>