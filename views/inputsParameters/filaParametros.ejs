<div
  id="divTableRowParams"
  class="divScrollParamsRows flex flex-col items-center justify-center w-full min-w-max"
>
  <table class="table-auto border-collapse w-full min-w-max" id="tableRows">
    <thead>
      <tr>
        <th class="p-2 bg-[#8cafef]"><strong>*</strong></th>
        <th class="cardInputHead"><strong>Tipo</strong></th>
        <th class="cardInputHead"><strong>Categoría</strong></th>
        <th class="cardInputHead"><strong>Subcategoría</strong></th>
        <th class="cardInputHead"><strong>Pieza del Fabricante</strong></th>
        <th class="cardInputHead"><strong>Margen</strong></th>
        <th class="cardInputHead">
          <strong>Codigo <br />Producto</strong>
        </th>
        <th class="cardInputHead"><strong>Descripción</strong></th>
        <th class="cardInputHead"><strong>Cantidad</strong></th>
        <th class="cardInputHead"><strong>Unidad de Medida</strong></th>
        <th class="cardInputHead"><strong>Descuento</strong></th>
        <th class="cardInputHead"><strong>Financiamiento</strong></th>
        <th class="cardInputHead"><strong>Dueño</strong></th>
        <th class="thBoton bg-[#ffffff] border-white"><strong></strong></th>
      </tr>
    </thead>
    <tbody id="tbodyRows">
      <tr class="rowData" id="tr1">
        <td>
          <div>
            <strong class="iden inputData">1</strong>
          </div>
        </td>
        <td class="cardInputData">
          <input
            required
            type="text"
            name="type"
            id="type1"
            class="inputData"
          />
        </td>
        <td class="cardInputData">
          <input type="text" name="category" id="category1" class="inputData" />
        </td>
        <td class="cardInputData">
          <input
            type="text"
            name="subcategory"
            id="subcategory1"
            class="inputData"
          />
        </td>
        <td class="cardInputData">
          <input
            required
            type="text"
            name="manufacturerPart"
            id="manufacturerPart1"
            class="inputData"
          />
        </td>
        <td class="cardInputData">
          <input
            required
            class="inputNumber inputData"
            type="number"
            name="margin"
            id="margin1"
          />
        </td>
        <td class="cardInputData">
          <input
            type="text"
            name="productCode"
            id="productCode1"
            class="inputData"
          />
        </td>
        <td class="cardInputData">
          <input
            type="text"
            name="description"
            id="description1"
            class="inputData"
          />
        </td>
        <td class="cardInputData">
          <input
            required
            type="number"
            class="inputNumber inputData"
            name="qty"
            id="qty1"
            
          />
        </td>
        <td class="cardInputData">
          <input
            type="text"
            name="unitMeasure"
            id="unitMeasure1"
            class="inputData"
          />
        </td>
        <td class="cardInputData">
          <input
            required
            type="number"
            min="0"
            class="inputNumber inputData"
            name="discount"
            id="discount1"
          />
        </td>
        <td class="cardInputData">
          <input
            required
            type="text"
            name="finance"
            id="finance1"
            class="inputData"
          />
        </td>
        <td class="cardInputData">
          <input type="text" name="owner" id="owner1" class="inputData" />
        </td>
        <td class="tdBoton" id="tdBoton">
          <button class="buttonMenos" type="button" form="">-</button>
        </td>
      </tr>
    </tbody>
  </table>
</div>
<div class="divButton flex flex-col justify-center items-center">
  <div id="divInputIncr" class="divInputIncrement">
    <table id="tableIncr">
      <thead>
        <tr>
          <th class="p-1 bg-[#4CAF50]"><strong class="text-white">N° Filas+</strong></th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td ><input type="number" name="" id="increment" min="1" max="100" class="" value="1"/></td>
        </tr>
      </tbody>
    </table>
  </div>
  <button class="buttonMas" type="button" id="tdMas" form="tableIncr">+</button>
</div>
