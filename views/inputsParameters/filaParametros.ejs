<div class="divButton flex flex-col justify-center items-center">
  <div id="divInputIncr" class="divInputIncrement">
    <table id="tableIncr">
      <thead>
        <tr>
          <th class="p-1 bg-[#4CAF50]">
            <strong class="text-white">N° Filas+</strong>
          </th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            <input
              type="number"
              name=""
              id="increment"
              min="1"
              max="100"
              class=""
              value="1"
            />
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  <button class="buttonMas" type="button" id="tdMas" form="tableIncr">+</button>
</div>
