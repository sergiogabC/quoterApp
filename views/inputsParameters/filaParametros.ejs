            type="number"
            class="inputNumber inputData"
            name="qty"
            id="qty1"
          />
        </td>
        <td class="cardInputData">
          <input
            type="text"
            name="unitMeasure"
            id="unitMeasure1"
            class="inputData"
          />
        </td>
        <td class="cardInputData">
          <input
            required
            type="number"
